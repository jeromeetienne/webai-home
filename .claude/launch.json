{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "webai-gateway",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--workspace", "@webai/gateway"],
      "port": 8787
    },
    {
      "name": "worker-page",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--workspace", "@webai/worker-webpage", "--", "--port", "8789", "--strictPort"],
      "port": 8789
    },
    {
      "name": "log-visu",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--workspace", "@webai/log-visu"],
      "port": 5173
    },
    {
      "name": "flow-viewer",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "flow_viewer", "--workspace", "@webai/flow-viewer", "--", "--port", "5599", "--no-open", "--no-autoplay"],
      "port": 5599
    }
  ]
}
