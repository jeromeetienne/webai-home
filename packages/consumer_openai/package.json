		"typecheck": "tsc -p tsconfig.json",
		"dev": "tsx src/cli.ts",
		"start": "node dist/cli.js",
		"test": "npx tsx --test tests/index.test.ts",
		"test:real:dev_formula": "npx tsx --test tests/real_dev_formula.test.ts",
		"test:real:dev_formula:headed": "REAL_TEST_HEADED=true npx tsx --test tests/real_dev_formula.test.ts",
		"test:real:llm_qwen3_0_6b_sharded": "npx tsx --test tests/real_llm_qwen3_0_6b_sharded.test.ts",
