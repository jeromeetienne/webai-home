		"example:chat_completion_llm_llama3_2_3b_full": "tsx examples/chat_completion_llm_llama3_2_3b_full.ts",
		"example:chat_completion_streaming_llm_llama3_2_3b_full": "tsx examples/chat_completion_streaming_llm_llama3_2_3b_full.ts",
		"example:chatbot_tool_calling": "tsx examples/chatbot_tool_calling.ts"
