		"example:chat_completion_system_message": "tsx examples/chat_completion_system_message.ts",
		"example:chat_completion_llm_gemma_nano_chrome_full": "tsx examples/chat_completion_llm_gemma_nano_chrome_full.ts",
		"example:chat_completion_streaming_llm_gemma_nano_chrome_full": "tsx examples/chat_completion_streaming_llm_gemma_nano_chrome_full.ts",
		"example:chat_completion_llm_qwen3_0_6b_sharded": "tsx examples/chat_completion_llm_qwen3_0_6b_sharded.ts",
		"example:chat_completion_streaming_llm_qwen3_0_6b_sharded": "tsx examples/chat_completion_streaming_llm_qwen3_0_6b_sharded.ts",
		"example:chat_completion_llm_qwen3_5_0_8b_full": "tsx examples/chat_completion_llm_qwen3_5_0_8b_full.ts",
