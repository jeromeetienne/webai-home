{
  "name": "@webai/consumer",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "sample:formula": "node --import tsx src/cli.ts --type formula --name formula-consumer 5 | jq",
    "sample:llm": "node --import tsx src/cli.ts --type llm --name llm-consumer 'What is the capital of France?' | jq",
    "build": "vite build && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "web": "vite",
    "preview": "vite preview",
    "test": "node --import tsx --test tests/index.test.ts"
  },
  "dependencies": {
    "@webai/protocol": "0.1.0",
    "commander": "^12.1.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/ws": "^8.5.13",
    "vite": "^6.4.3"
  }
}
