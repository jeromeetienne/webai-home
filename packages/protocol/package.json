{
  "name": "@webai/protocol",
  "version": "0.1.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./message_logger": {
      "types": "./dist/message/message_logger.d.ts",
      "default": "./dist/message/message_logger.js"
    },
    "./task_projection": {
      "types": "./dist/task/task_projection.d.ts",
      "default": "./dist/task/task_projection.js"
    },
    "./envelope": {
      "types": "./dist/message/envelope.d.ts",
      "default": "./dist/message/envelope.js"
    },
    "./session_renewal": {
      "types": "./dist/session_renewal.d.ts",
      "default": "./dist/session_renewal.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "npx tsx --test tests/index.test.ts"
  },
  "dependencies": {
    "zod": "^3.24.1"
  }
}
